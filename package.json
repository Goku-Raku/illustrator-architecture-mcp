{
  "name": "illustrator-architecture-mcp",
  "version": "0.1.0-alpha.1",
  "description": "Editable architectural and urban site diagrams for Adobe Illustrator: calibrated maps, evidence-aware overlays and bundled analysis guidance. Public-source alpha.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "illustrator-architecture-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "skills/architecture-diagramming/**/*",
    "scripts/verify-offline.mjs",
    "scripts/generate-config.mjs",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "README.ja.md",
    "AGENT_SETUP.md",
    "UPSTREAM.md",
    "ACKNOWLEDGEMENTS.md",
    "DISCLAIMER.md",
    "THIRD_PARTY_NOTICES.md",
    "PRIVACY.md",
    "SECURITY.md",
    "examples/urban-demo.png",
    "examples/urban-demo.zh-TW.png",
    "examples/urban-demo.zh-CN.png",
    "examples/urban-demo.en.png",
    "examples/urban-demo.ja.png",
    "examples/urban-site-input.json",
    "README-ARCHITECTURE.md",
    "ARCHITECTURE-WORKFLOWS.md",
    "VALIDATION*.md",
    "examples/README.md",
    "docs/ANALYSIS-ATLAS.zh-CN.md",
    "docs/DIAGRAM-METHODOLOGY.zh-CN.md",
    "docs/PINTEREST-RESEARCH.zh-CN.md",
    "docs/UPGRADE-NOTES.zh-CN.md",
    "docs/UPGRADE-V3.zh-CN.md",
    "docs/URBAN-PINTEREST-RESEARCH.zh-CN.md",
    "docs/URBAN-SITE-ANALYSIS.zh-CN.md",
    "docs/VALIDATION-ALPHA.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node -e \"require('fs').cpSync('src/jsx','dist/jsx',{recursive:true})\" && tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "config:generate": "node scripts/generate-config.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "illustrator",
    "adobe",
    "extendscript",
    "jsx",
    "design",
    "svg"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7",
    "esbuild": "^0.28.2"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goku-Raku/illustrator-architecture-mcp.git"
  },
  "homepage": "https://github.com/Goku-Raku/illustrator-architecture-mcp#readme",
  "bugs": {
    "url": "https://github.com/Goku-Raku/illustrator-architecture-mcp/issues"
  }
}
